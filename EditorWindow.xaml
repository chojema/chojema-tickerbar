<Window x:Class="ChojemaTickerBar.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chojema TickerBar" Language="ko-KR" ThemeMode="System"
        Icon="/ChojemaTickerBar;component/Assets/TickerBar.ico"
        Width="1000" Height="720" MinWidth="840" MinHeight="580"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Malgun Gothic" FontSize="14">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- Fluent 테마에 ToggleSwitch 스타일이 없어 CheckBox 템플릿으로 만든다. -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="StateText" Text="끔" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid Width="40" Height="20">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StateText" Property="Text" Value="켬" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                                <Setter TargetName="Knob" Property="Margin" Value="3,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="68" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Colours only the cell text, so the Fluent row template and its selection colours stay intact. -->
        <Style x:Key="UrgencyText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="임박" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="지연" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Popover" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Chojema TickerBar" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,8" />

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
            <TabItem Header="일정과 메모">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="20,16,16,8">
                                <Button DockPanel.Dock="Right" Click="New_Click" Style="{DynamicResource AccentButtonStyle}"
                                        AutomationProperties.Name="새 항목">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="새 항목" />
                                    </StackPanel>
                                </Button>
                                <Label x:Name="ItemsLabel" Target="{Binding ElementName=ItemsGrid}" Content="항목"
                                       FontSize="20" FontWeight="SemiBold" Padding="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid x:Name="ItemsGrid" Grid.Row="1" Margin="8,0,8,8"
                                      SelectionChanged="Items_SelectionChanged"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      CanUserReorderColumns="False" CanUserSortColumns="False"
                                      CanUserResizeRows="False" SelectionMode="Single"
                                      HeadersVisibility="Column" GridLinesVisibility="None"
                                      Background="Transparent" BorderThickness="0" RowHeight="40"
                                      AutomationProperties.LabeledBy="{Binding ElementName=ItemsLabel}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="내용" Binding="{Binding Text}" Width="*" ElementStyle="{StaticResource UrgencyText}" />
                                    <DataGridTextColumn Header="일정" Binding="{Binding DisplayTime}" Width="140" ElementStyle="{StaticResource UrgencyText}" />
                                    <DataGridTextColumn Header="반복" Binding="{Binding RepeatLabel}" Width="64" ElementStyle="{StaticResource UrgencyText}" />
                                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="72" ElementStyle="{StaticResource UrgencyText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock x:Name="EditorTitle" DockPanel.Dock="Top" Text="새 항목"
                                       Style="{DynamicResource SubtitleTextBlockStyle}" />

                            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
                                <Button x:Name="SaveItemButton" DockPanel.Dock="Right" Content="항목 추가"
                                        Click="SaveItem_Click" MinWidth="104" IsDefault="True"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <Button x:Name="DeleteButton" DockPanel.Dock="Left" Click="Delete_Click"
                                        IsEnabled="False" AutomationProperties.Name="삭제">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="삭제" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                            <StackPanel>
                                <Label Target="{Binding ElementName=ItemText}" Content="내용" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ItemText" MaxLength="160" TextWrapping="Wrap"
                                         MaxHeight="84" VerticalScrollBarVisibility="Auto" />

                                <DockPanel Margin="0,16,0,0">
                                    <TextBlock x:Name="DatePreview" DockPanel.Dock="Right" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                    <Label Target="{Binding ElementName=DueText}" Content="일정"
                                           Style="{StaticResource FieldLabel}" Margin="0" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DueText" MaxLength="16"
                                             ToolTip="12-1 또는 2026-12-01. 필요하면 뒤에 HH:mm을 붙입니다." />
                                    <Button x:Name="CalendarButton" Grid.Column="1" Content="&#xE787;"
                                            Style="{StaticResource IconButton}" Click="OpenCalendar_Click"
                                            ToolTip="달력" AutomationProperties.Name="달력" />
                                    <Button x:Name="ClockButton" Grid.Column="2" Content="&#xE823;"
                                            Style="{StaticResource IconButton}" Click="OpenClock_Click"
                                            ToolTip="시계" AutomationProperties.Name="시계" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="예: 12-1 또는 2026-12-01 14:30. 비워 두면 메모가 됩니다." />

                                <Label Target="{Binding ElementName=RepeatPicker}" Content="반복" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="RepeatPicker" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="반복 없음" />
                                    <ComboBoxItem Content="매일" />
                                    <ComboBoxItem Content="매주" />
                                    <ComboBoxItem Content="매월" />
                                    <ComboBoxItem Content="매년" />
                                </ComboBox>

                                <CheckBox x:Name="PinnedCheck" Content="메모를 맨 앞에 고정" Margin="0,18,0,0" />
                                <CheckBox x:Name="CompletedCheck" Content="완료" Checked="Completed_Checked" Margin="0,8,0,0" />
                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=CalendarButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                        <Border Style="{StaticResource Popover}" PreviewKeyDown="Picker_PreviewKeyDown">
                            <StackPanel>
                                <Calendar x:Name="DueCalendar" SelectionMode="SingleDate" />
                                <Button x:Name="ApplyDateButton" Content="날짜 적용" Click="ApplyDate_Click"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                        Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="ClockPopup" PlacementTarget="{Binding ElementName=ClockButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                        <Border Style="{StaticResource Popover}" PreviewKeyDown="Picker_PreviewKeyDown">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,8,0">
                                        <Label Target="{Binding ElementName=HourList}" Content="시" HorizontalAlignment="Center" />
                                        <ListBox x:Name="HourList" Width="76" Height="180" HorizontalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Label Target="{Binding ElementName=MinuteList}" Content="분" HorizontalAlignment="Center" />
                                        <ListBox x:Name="MinuteList" Width="76" Height="180" HorizontalContentAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Button x:Name="ClearTimeButton" Content="시간 빼기" Click="ClearTime_Click"
                                            HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                                    <Button x:Name="ApplyTimeButton" Content="적용" Click="ApplyTime_Click"
                                            HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </TabItem>

            <TabItem Header="표시 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,12"
                                   Text="바꾼 설정은 바로 티커에 적용되고 저장됩니다." />

                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <ComboBox x:Name="MonitorPicker" DockPanel.Dock="Right" Width="240" Margin="24,0,0,0" VerticalAlignment="Center"
                                          DisplayMemberPath="Label" SelectedValuePath="DeviceName"
                                          AutomationProperties.LabeledBy="{Binding ElementName=MonitorTitle}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="MonitorTitle" Text="표시 모니터" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="티커를 띄울 화면입니다." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <ComboBox x:Name="EdgePicker" DockPanel.Dock="Right" Width="240" Margin="24,0,0,0" VerticalAlignment="Center"
                                          AutomationProperties.LabeledBy="{Binding ElementName=EdgeTitle}">
                                    <ComboBoxItem Content="위쪽" />
                                    <ComboBoxItem Content="아래쪽" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="EdgeTitle" Text="화면 위치" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="티커를 붙일 화면 가장자리입니다." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <ComboBox x:Name="DirectionPicker" DockPanel.Dock="Right" Width="240" Margin="24,0,0,0" VerticalAlignment="Center"
                                          AutomationProperties.LabeledBy="{Binding ElementName=DirectionTitle}">
                                    <ComboBoxItem Content="오른쪽에서 왼쪽으로" />
                                    <ComboBoxItem Content="왼쪽에서 오른쪽으로" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DirectionTitle" Text="흐르는 방향" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="일정과 메모가 지나가는 방향입니다." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <CheckBox x:Name="DateCheck" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=DateTitle}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DateTitle" Text="날짜와 요일 표시" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="띠 오른쪽 끝에 ‘11월 24일 火’ 형식으로 고정합니다." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <CheckBox x:Name="TopmostCheck" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=TopmostTitle}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TopmostTitle" Text="항상 위에 표시" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="다른 창에 가려지지 않게 합니다." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="Feedback" Grid.Row="2" Margin="2,10,0,0" MinHeight="18" TextWrapping="Wrap"
                   Style="{StaticResource Caption}" FontSize="13" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
