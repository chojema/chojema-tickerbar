<Window x:Class="ChojemaTickerBar.TickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chojema TickerBar" Language="ko-KR" FlowDirection="LeftToRight"
        Icon="/ChojemaTickerBar;component/Assets/TickerBar.ico"
        Width="640" Height="36" UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        Background="#14232B">
    <Window.Resources>
        <SolidColorBrush x:Key="AlternateItem" Color="#A6E8D9" />
        <SolidColorBrush x:Key="ItemSeparator" Color="#779597" />
        <SolidColorBrush x:Key="ImminentItem" Color="#FFC857" />
        <SolidColorBrush x:Key="OverdueItem" Color="#FF8A80" />
        <Style x:Key="TapeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECF6F4" />
            <Setter Property="FontFamily" Value="Malgun Gothic" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="#426A68" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Border Background="#1D3740" BorderBrush="#426A68" BorderThickness="0,0,1,0"
                    ToolTip="현재 창의 키보드 입력 상태">
                <TextBlock x:Name="InputModeBadge" Text="—" Style="{StaticResource TapeText}"
                           Foreground="#AFEFE0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Canvas x:Name="Viewport" Grid.Column="1" ClipToBounds="True" Background="Transparent"
                    SizeChanged="Viewport_SizeChanged">
                <TextBlock x:Name="EmptyMessage" Canvas.Left="18" Canvas.Top="6"
                           Style="{StaticResource TapeText}" Foreground="#ABC3C1"
                           Text="티커를 두 번 클릭해 일정이나 메모를 추가하세요." />
                <StackPanel x:Name="Tape" Orientation="Horizontal">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="Motion" />
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>
            <Border x:Name="DateBadge" Grid.Column="2" Visibility="Collapsed"
                    Background="#1D3740" BorderBrush="#426A68" BorderThickness="1,0,0,0" Padding="12,0">
                <TextBlock x:Name="DateLabel" Style="{StaticResource TapeText}" VerticalAlignment="Center" />
            </Border>
            <Button x:Name="ExitButton" Grid.Column="3" Content="×" Cursor="Hand" ToolTip="앱 종료"
                    AutomationProperties.Name="앱 종료" Click="Exit_Click" Background="Transparent"
                    Foreground="#D5E9E6" BorderBrush="#426A68" BorderThickness="1,0,0,0"
                    FontFamily="Segoe UI" FontSize="22">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#853C46" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#71323A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="#AFEFE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
